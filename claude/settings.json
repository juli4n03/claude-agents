{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(ls *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(pip show *)",
      "Bash(pip list *)",
      "Bash(python ~/.claude/bin/schema.py *)",
      "Bash(python3 ~/.claude/bin/schema.py *)",
      "Bash(python ~/.claude/hooks/check_nb.py *)",
      "Bash(python3 ~/.claude/hooks/check_nb.py *)",
      "Bash(aws s3 ls *)",
      "Bash(aws glue get-*)",
      "Bash(aws athena get-*)",
      "Bash(aws athena list-*)"
    ],
    "deny": [
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(aws glue delete-*)",
      "Bash(aws athena delete-*)",
      "Bash(aws s3api delete-*)"
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": { "source": "github", "repo": "anthropics/claude-plugins-official" }
    }
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/check_nb.py --marca" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/guard_bash.py" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 ~/.claude/hooks/check_nb.py" }
        ]
      }
    ]
  }
}
